  m_Script: {fileID: 11500000, guid: 41d91c116c340984f9707ea72e48148e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Book1: {fileID: 172610448}
  ExitButton: {fileID: 1689458071}
  PopGropTime: 0.05
  SwichTime: 0.5
  DialougueText: {fileID: 496073799}
  plotClip:
  - Name: B1
    StoryText:
    - "\u300A\u8003\u5DE5\u8BB0\u300B\u662F\u6536\u5F55\u4E8E\u300A\u5468\u793C\u300B\u7684\u6218\u56FD\u65F6\u671F\u6587\u732E\uFF0C\u90E8\u5206\u5B66\u8005\u8BA4\u4E3A\u5176\u539F\u4E3A\u6625\u79CB\u672B\u671F\u9F50\u56FD\u5DE5\u827A\u5B98\u4E66\uFF0C\u897F\u6C49\u65F6\u8865\u5165\u300A\u5468\u793C\xB7\u51AC\u5B98\u300B\u3002\u300A\u8003\u5DE5\u8BB0\u300B\u6210\u4E66\u4E8E\u6625\u79CB\u6218\u56FD\u65F6\u671F\uFF0C\u539F\u4E3A\u9F50\u56FD\u5B98\u4E66\uFF0C\u540E\u8865\u5165\u300A\u5468\u793C\xB7\u51AC\u5B98\u300B\uFF0C\u5168\u65877100\u4F59\u5B57\u3002 
      \u300A\u8003\u5DE5\u8BB0\u300B\u7CFB\u7EDF\u8BB0\u8F7D\u4E86\u653B\u76AE\u3001\u653B\u6728\u3001\u653B\u91D1\u3001\u8BBE\u8272\u3001\u522E\u6469\u3001\u629F\u57F46\u5927\u7C7B\u517130\u4E2A\u5DE5\u79CD\u7684\u5DE5\u827A\u89C4\u8303\u4E0E\u6280\u672F\u6807\u51C6\u3002\u5168\u4E66\u6240\u8BB0\u5DE5\u827A\u5206\u516D\u7C7B\u4E09\u5341\u4E2A\u5DE5\u79CD\uFF0C\u5305\u62EC\u653B\u6728\u4E4B\u5DE5\u3001\u653B\u91D1\u4E4B\u5DE5\u3001\u653B\u76AE\u4E4B\u5DE5\u3001\u8BBE\u8272\u4E4B\u5DE5\u3001\u522E\u6469\u4E4B\u5DE5\u3001\u640F\u57F4\u4E4B\u5DE5\u7B49\uFF0C\u5206\u522B\u8BB0\u8FF0\u6728\u5DE5\u3001\u91D1\u5DE5\u3001\u76AE\u9769\u3001\u67D3\u8272\u3001\u5236\u9676\u548C\u57CE\u5E02\u89C4\u5212\u7B49\u624B\u5DE5\u4E1A\u7684\u5236\u4F5C\u5DE5\u827A\u548C\u68C0\u9A8C\u65B9\u6CD5\u3002\u4E66\u4E2D\u6784\u5EFA\u4E86\u4E25\u5BC6\u7684\u5DE5\u5320\u79F0\u8C13\u4F53\u7CFB\u3002
      \u300A\u8003\u5DE5\u8BB0\u300B\u63D0\u51FA\u201C\u5929\u6709\u65F6\uFF0C\u5730\u6709\u6C14\uFF0C\u6750\u6709\u7F8E\uFF0C\u5DE5\u6709\u5DE7\u201D\u7684\u9020\u7269\u51C6\u5219\u3002 
      \u300A\u5320\u4EBA\u300B\u7BC7\u662F\u5176\u4E2D\u5173\u4E8E\u90FD\u57CE\u8425\u5EFA\u5236\u5EA6\u7684\u4E13\u7AE0\u3002\u300A\u8003\u5DE5\u8BB0\xB7\u5320\u4EBA\u300B\u63D0\u51FA\u4E86\u201C\u5320\u4EBA\u8425\u56FD\uFF0C\u65B9\u4E5D\u91CC\uFF0C\u65C1\u4E09\u95E8\u3002\u56FD\u4E2D\u4E5D\u7ECF\u4E5D\u7EAC\uFF0C\u7ECF\u6D82\u4E5D\u8F68\u3002\u5DE6\u7956\u53F3\u793E\uFF0C\u9762\u671D\u540E\u5E02\uFF0C\u5E02\u671D\u4E00\u592B\u201D\u7684\u90FD\u57CE\u89C4\u5212\u7406\u8BBA\u3002
      \u8BE5\u6587\u732E\u8BB0\u8F7D\u4E86\u897F\u5468\u521D\u671F\u5F62\u6210\u7684\u90FD\u57CE\u8425\u5EFA\u5236\u5EA6\uFF0C\u5305\u542B\u201C\u5320\u4EBA\u8425\u56FD\u201D\u7684\u56FD\u571F\u7A7A\u95F4\u89C4\u5212\u7406\u8BBA\u3002"
  - Name: B2
    StoryText:
    - "\u300A\u8425\u9020\u6CD5\u5F0F\u300B\u662F\u5317\u5B8B\u5C06\u4F5C\u76D1\u674E\u8BEB\u5728\u4E24\u6D59\u5DE5\u5320\u55BB\u7693\u300A\u6728\u7ECF\u300B\u57FA\u7840\u4E0A\u5949\u6555\u7F16\u4FEE\u7684\u5EFA\u7B51\u5B66\u8457\u4F5C\uFF0C\u59CB\u7F16\u4E8E\u7199\u5B81\u5E74\u95F4\uFF0C\u5143\u7950\u516D\u5E74\u521D\u6210\u540E\u56E0\u5DE5\u6599\u5B9A\u989D\u5BBD\u677E\uFF0C\u4E8E\u7ECD\u5723\u56DB\u5E74\u7531\u674E\u8BEB\u91CD\u4FEE\uFF0C\u5D07\u5B81\u4E8C\u5E74\u7531\u671D\u5EF7\u520A\u5370\u9881\u884C\u3002
      \u8BE5\u4E66\u65E8\u5728\u901A\u8FC7\u89C4\u8303\u5EFA\u7B51\u8BBE\u8BA1\u3001\u65BD\u5DE5\u6807\u51C6\u53CA\u7528\u6599\u5B9A\u989D\uFF0C\u89E3\u51B3\u5317\u5B8B\u5EFA\u7B51\u4E1A\u865A\u62A5\u7269\u6599\u3001\u8425\u79C1\u821E\u5F0A\u7B49\u95EE\u9898\u3002\u5168\u4E66\u517134\u5377\uFF0C\u5206\u4E3A\u603B\u91CA\u603B\u4F8B\u3001\u5404\u4F5C\u5236\u5EA6\u3001\u529F\u9650\u3001\u6599\u4F8B\u3001\u56FE\u6837\u4E94\u90E8\u5206\u3002\u524D\u4E24\u5377\u4E3A\u5EFA\u7B51\u672F\u8BED\u603B\u91CA\u53CA\u8BA1\u7B97\u901A\u5219\uFF0C\u7B2C\u4E09\u81F3\u5341\u4E94\u5377\u8BE6\u8FF0\u5341\u4E09\u7C7B\u5DE5\u79CD\u8425\u9020\u89C4\u8303\uFF0C\u5176\u4E2D\u4EE5\u5927\u6728\u4F5C\u5236\u5EA6\u4E3A\u6838\u5FC3\uFF0C\u9996\u6B21\u63D0\u51FA\"\u6750\u5206\u516B\u7B49\"\u7684\u6A21\u6570\u4F53\u7CFB
      \u3002\u540E\u516D\u5377\u6536\u5F55\u56FE\u6837\uFF0C\u5305\u542B\u5EFA\u7B51\u6784\u9020\u8BE6\u56FE\u4E0E\u88C5\u9970\u7EB9\u6837\u3002\u8BE5\u4E66\u7CFB\u7EDF\u603B\u7ED3\u5317\u5B8B\u4EE5\u524D\u5EFA\u7B51\u6280\u672F\uFF0C\u662F\u4E2D\u56FD\u53E4\u4EE3\u6700\u5B8C\u6574\u7684\u5EFA\u7B51\u6280\u672F\u4E66\u7C4D\uFF0C\u53CD\u6620\u5B8B\u4EE3\u5EFA\u7B51\u6A21\u6570\u5316\u3001\u6807\u51C6\u5316\u7279\u5F81\uFF0C\u6807\u5FD7\u7740\u4E2D\u56FD\u53E4\u4EE3\u5EFA\u7B51\u53D1\u5C55\u5230\u4E86\u8F83\u9AD8\u9636\u6BB5\u3002 "
